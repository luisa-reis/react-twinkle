{
  "name": "react-twinkle-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "An example app: a dashboard of pages and widgets for a 64x64 LED panel, built on react-twinkle",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fonts": "tsx scripts/fetch-fonts.ts",
    "prestart": "npm run fonts",
    "start": "tsx src/main.tsx",
    "predev": "npm run fonts",
    "dev": "tsx watch --clear-screen=false src/main.tsx",
    "presnapshot": "npm run fonts",
    "snapshot": "tsx src/main.tsx --demo --png dashboard.png",
    "pretest": "npm run fonts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-twinkle": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
