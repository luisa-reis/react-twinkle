{
  "name": "react-twinkle",
  "version": "0.1.0",
  "description": "React for LED matrices: a custom renderer that draws components into a pixel canvas, the way Ink draws them into a terminal",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.build.json",
    "screenshots": "npm run build && tsx scripts/screenshots.ts",
    "lint": "eslint --ext .ts,.tsx,.cjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "react-reconciler": "^0.29.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/omggif": "^1.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-reconciler": "^0.28.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
